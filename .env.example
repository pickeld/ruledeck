# Copy to .env locally. Do not commit real values.
# scripts/bootstrap-env.sh writes a real .env plus gitignored .local-credentials.
DATABASE_URL=postgresql://ruledeck:replace-with-local-password@postgres:5432/ruledeck
POSTGRES_USER=ruledeck
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=ruledeck
SESSION_SECRET=replace-with-at-least-32-random-characters
SEED_MANAGER_PASSWORD=replace-me
SEED_DEVELOPER_PASSWORD=replace-me
OUTPUT_ROOT=/output
RULEDECK_HTTPS=false
APP_PUBLIC_URL=http://127.0.0.1:3000
